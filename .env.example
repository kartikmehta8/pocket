# ---------------------------------------------------------------------------
# Purse configuration
#
# Copy to .env and fill in. Purse runs with none of the vendor keys set: each
# adapter falls back to a deterministic in-memory fake, and /v1/health reports
# which mode every adapter resolved to. See SETUP_KEYS.md for how to get keys.
# ---------------------------------------------------------------------------

# --- Required ---
DATABASE_URL=postgres://purse:purse@localhost:5434/purse

# --- API ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
CHAIN=hedera-testnet

# --- Privy (wallets and signing) ---
# Leave blank to use the in-memory wallet fake.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional. Privy only requires a request signature when a wallet has an owner,
# and Purse creates app-owned wallets with none, so this can stay blank.
# Create one at dashboard.privy.io -> Wallets -> Authorization keys -> New key.
# Paste it whole, prefix included: wallet-auth:MIGHAgEAMBMGByqGSM49...
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Pin an existing Privy policy instead of minting a new one on each start.
# Purse creates one automatically on first wallet if this is blank.
PRIVY_POLICY_ID=

# --- Hedera (settlement) ---
# A public relay endpoint, not a key. Leave blank to use the in-memory fake.
# Testnet: https://testnet.hashio.io/api   (chain 296, dev use, rate limited)
# Mainnet: https://mainnet.hashio.io/api   (chain 295)
HEDERA_RPC_URL=
# Leave blank to settle in HBAR, which needs no contract address and no token
# association. Only set this if you specifically want USDC:
#   testnet USDC = token 0.0.429274 = 0x0000000000000000000000000000000000068cda
# Note: a Hedera account must be associated with a token before it can receive
# it, so a fresh Privy wallet cannot accept USDC until that is done. See
# SETUP_KEYS.md.
HEDERA_USDC_ADDRESS=

# --- The Graph (on-chain observability) ---
# Leave blank to fall back to Purse's own ledger for analytics.
#
# The Graph does not support Hedera, so there is no hosted URL to paste and no
# API key to obtain. Run the bundled local Graph Node instead:
#   cd subgraph && npm install && npm run node:up && npm run deploy-local
#   GRAPH_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/purse/transfers
# GRAPH_API_KEY stays empty for a local node; it is only for the hosted gateway
# (https://gateway.thegraph.com/api/subgraphs/id/<ID>) on a supported chain.
GRAPH_SUBGRAPH_URL=
GRAPH_API_KEY=

# --- The Graph: composed market data (price-gated policy) ---
# Two Graph products cross-check each other. BOTH are required: a single price
# feed is a single point of failure for a control that decides whether money
# moves, so if only one is set, pricing stays off and any USD ceiling denies.
#
# 1. Subgraph via the decentralized gateway (Subgraph Studio API key):
GRAPH_PRICE_SUBGRAPH_URL=
# 2. The Graph Token API (JWT from The Graph Market dashboard):
GRAPH_TOKEN_API_URL=https://api.pinax.network
GRAPH_TOKEN_API_JWT=
# EVM network the price sources cover, and the token contract on it.
GRAPH_PRICE_NETWORK=mainnet
GRAPH_PRICE_USDC_CONTRACT=
GRAPH_PRICE_HBAR_CONTRACT=
# The Token API prices pools, not tokens, so each asset also needs the pool
# that trades it against a dollar. Mainnet USDC/USDT 0.01% is
# 0x3416cf6c708da44db2624d63ea0aaef7113527c6.
GRAPH_PRICE_USDC_POOL=
GRAPH_PRICE_HBAR_POOL=
# How far the two sources may diverge before Purse refuses to price, in bps.
GRAPH_PRICE_TOLERANCE_BPS=200

# --- Force every adapter to its fake, for offline demos and tests ---
USE_MOCK_ADAPTERS=false

# --- Paid x402 service (the demo seller) ---
PAID_SERVICE_PORT=8402
# Address the paid service asks to be paid at. SET THIS TO A WALLET YOU CONTROL.
#
# The 0x...dEaD default is the Ethereum burn-address convention and it does NOT
# behave that way on Hedera: low addresses map to real account numbers, so
# 0x...dEaD resolves to account 0.0.57005, which exists and holds a balance you
# do not control. Money sent there is gone, not burned. It is also not
# associated with USDC, so token payments to it are refused before broadcast.
PAID_SERVICE_ADDRESS=0x000000000000000000000000000000000000dEaD
PAID_SERVICE_PRICE=0.08
# Privy wallet id for the seller, printed by provision-merchant.ts. Needed only
# to associate the seller wallet with a token.
MERCHANT_PRIVY_WALLET_ID=

# --- x402 (facilitator-settled payments) ---
# The facilitator verifies and settles, and pays gas on Hedera.
# Whether the purchase endpoint may fetch loopback and private addresses. The
# API fetches URLs its callers choose, which is the shape of a server-side
# request forgery, so this is off in production and on everywhere else.
# The bundled seller runs on localhost, so local development needs it.
ALLOW_PRIVATE_RESOURCE_HOSTS=true

X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# Hedera token id to settle in, or HBAR for the native asset.
X402_ASSET=0.0.429274
X402_ASSET_DECIMALS=6
PAID_SERVICE_PREMIUM_PRICE=0.75
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# --- MCP server ---
MCP_PORT=8081
PURSE_API_URL=http://localhost:8080
# Organization API key the MCP server presents to the Purse API.
MCP_AGENT_TOKEN=

# --- Dashboard (server-side only; never exposed to the browser) ---
PURSE_API_KEY=

# NOTE: do not set NODE_ENV here. `next build` requires production and reads
# this file, so a development value here breaks the dashboard build.
