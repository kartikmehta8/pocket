# Without this, `COPY packages packages` lays the host's node_modules over the
# ones the deps stage installed. pnpm links them by absolute path, so every
# link points at a directory that does not exist in the image and the build
# fails on imports it can plainly see in package.json.
node_modules
**/node_modules

# Build output belongs to the stage that produces it.
dist
**/dist
.next
**/.next
**/.source
*.tsbuildinfo

# Secrets never enter the build context.
.env
.env.*
!.env.example
!.env.*.example

# Not part of any image. apps/docs and apps/dashboard are NOT excluded: each
# has its own Dockerfile that builds from this same root context, and excluding
# them here fails that build on a path it can see in the repository.
.git
.github
.githooks
.logs
subgraph
scripts
