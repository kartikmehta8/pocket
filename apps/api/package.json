{
  "name": "@pocket/api",
  "version": "0.1.0",
  "description": "Policy engine, payment ledger and audit trail, over HTTP.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "adopt": "tsx src/adopt.ts",
    "provision:treasury": "tsx src/provision-treasury.ts",
    "provision:merchant": "tsx src/provision-merchant.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@pocket/adapters": "workspace:*",
    "@pocket/core": "workspace:*",
    "@pocket/db": "workspace:*",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
