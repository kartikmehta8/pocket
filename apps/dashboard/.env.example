# --- Pocket API ---
# Base URL of the Pocket API this dashboard reads from.
POCKET_API_URL=http://localhost:8080

# Single-tenant escape hatch. When set, the dashboard authenticates every
# request with this organization key and sign-in is bypassed entirely.
# Leave it EMPTY for the multi-tenant deployment where people sign in.
POCKET_API_KEY=

# --- Sign-in (Privy) ---
# Application id from https://dashboard.privy.io. Safe to expose: it is a
# public identifier, not a secret. Without it the sign-in screen explains what
# to configure rather than offering a button that cannot work.
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Endpoints shown on the setup screen ---
# Where an agent runtime reaches your MCP server. This is the address the
# runtime can resolve, which is not necessarily the one your browser used.
NEXT_PUBLIC_MCP_URL=http://localhost:8081/mcp

# Optional. The example paid resource, used in the sample prompt.
NEXT_PUBLIC_PAID_SERVICE_URL=http://localhost:8402

# Where the documentation site is served from.
NEXT_PUBLIC_DOCS_URL=http://localhost:3001/docs

# The public domain this deployment answers on. Decides the absolute URLs in
# link previews and sitemap.xml, and which origins may submit a server action.
# Unset locally: the site then addresses itself as localhost.
# NEXT_PUBLIC_APP_DOMAIN=pocket-app.xyz
