# Where the product itself lives, for the "Open the app" link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The address this site gives out in every canonical link, sitemap entry and
# preview card. Leave it unset on Vercel, where the project's own production
# domain is used; set it anywhere else that serves the site on a real domain.
# Inlined at build time, so it has to be present when the build runs.
# NEXT_PUBLIC_DOCS_DOMAIN=docs.pocket-app.xyz
