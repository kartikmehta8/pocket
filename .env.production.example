# ---------------------------------------------------------------------------
# Production configuration for pocket-app.xyz
#
# Copy to .env.production and fill in. Leave a variable BLANK to take its
# default; a blank is never an error.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Release ---
# Set by the deploy workflow on the host. REGISTRY is your GHCR namespace,
# lowercase, and IMAGE_TAG is the commit the release pins to, so a rollback is
# a tag change rather than a rebuild.
REGISTRY=ghcr.io/kartikmehta8
IMAGE_TAG=latest

# --- Database ---
POSTGRES_USER=pocket
POSTGRES_PASSWORD=
POSTGRES_DB=pocket
DATABASE_URL=postgres://pocket:CHANGE_ME@postgres:5432/pocket

# --- API ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CHAIN=hedera-testnet
# Only the dashboard's own origin. The browser never calls the API directly,
# so nothing else belongs here.
CORS_ORIGINS=https://pocket-app.xyz
RATE_LIMIT_MAX=120
# Blank, so production resolves it to false and refuses to fetch private and
# loopback addresses. Set it to true ONLY to reach a seller inside this network.
ALLOW_PRIVATE_RESOURCE_HOSTS=

# --- Privy ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_POLICY_ID=

# --- Hedera ---
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# --- x402 ---
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_ASSET=0.0.429274
X402_ASSET_DECIMALS=6

# --- The Graph ---
GRAPH_SUBGRAPH_URL=
GRAPH_API_KEY=
GRAPH_PRICE_SUBGRAPH_URL=
GRAPH_TOKEN_API_URL=https://api.pinax.network
GRAPH_TOKEN_API_JWT=
GRAPH_PRICE_NETWORK=mainnet
GRAPH_PRICE_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
GRAPH_PRICE_USDC_POOL=0x3416cf6c708da44db2624d63ea0aaef7113527c6
GRAPH_PRICE_TOLERANCE_BPS=200

# --- Paid service (the x402 seller) ---
PAID_SERVICE_PORT=8402
PAID_SERVICE_ADDRESS=
PAID_SERVICE_PRICE=0.08
PAID_SERVICE_PREMIUM_PRICE=0.75
# The seller advertises this in its 402 challenge. An agent that reads
# localhost here cannot pay you, so it must be the public address.
PAID_SERVICE_PUBLIC_URL=https://pay.pocket-app.xyz

# --- MCP server ---
MCP_PORT=8081
POCKET_API_URL=http://pocket-api:8080
MCP_AGENT_TOKEN=

# --- Dashboard build args (compiled in; see docker-compose.prod.yml) ---
NEXT_PUBLIC_PRIVY_APP_ID=
